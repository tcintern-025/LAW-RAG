# --- Required ---
GROQ_API_KEY=your_groq_api_key_here

# --- Tenant / branding (edit these to resell to a new client) ---
CLIENT_ID=pakistan-law-demo
PRODUCT_NAME=Pakistan Law Assistant
PRODUCT_TAGLINE=Ask questions about Pakistani law and get grounded, sourced answers.
DOMAIN_LABEL=Pakistani law
DISCLAIMER=This response is generated for general informational and educational purposes only. It is not legal advice and does not create a lawyer-client relationship. Consult a licensed attorney in your jurisdiction before acting on any legal matter.

# --- Documents / storage ---
DOCUMENTS_DIR=data/documents
CHROMA_PERSIST_DIR=data/chroma

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
USE_MMR=true

# --- CORS (comma-separated list of allowed frontend origins) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
